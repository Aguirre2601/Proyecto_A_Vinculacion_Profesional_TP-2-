# Configuración de Puertos
N8N_PORT=5678
BACKEND_PORT=8000
FRONTEND_PORT=8501

# n8n Host Configuration
N8N_HOST=localhost

# Conexión Backend
DATABASE_URL=sqlite:///./data/vinculacion.db
BACKEND_API_URL=http://backend:8000

# Clave de API de Inteligencia Artificial (Google Gemini)
# Opcional: déjala vacía para usar el generador pedagógico offline.
# Obtén una clave gratuita en https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-3.8-flash
